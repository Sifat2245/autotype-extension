{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run AutoType (isolated)",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--disable-extensions",
        "--user-data-dir=${workspaceFolder}/.vscode-test/dev-profile",
        "--extensions-dir=${workspaceFolder}/.vscode-test/dev-extensions"
      ],
      "timeout": 30000,
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "npm: compile"
    }
  ]
}
